# Copy to .env next to docker-compose.yml and adjust.

# Release to run (the image tag, for example 1.0.0). Required by docker-compose.yml; the source build
# (docker-compose.build.yml) ignores it.
DEFE2END_VERSION=

# Host port for the web UI and API.
WEB_PORT=3000

# Public URL users open (scheme + host + port). Cookies are marked Secure when it is https.
BETTER_AUTH_URL=http://localhost:3000

# Required secrets. Generate each with: openssl rand -base64 32
# Session signing secret (at least 32 characters).
BETTER_AUTH_SECRET=
# Encrypts secret variables. Back it up together with the database; the web server
# refuses to start if it differs from the key the database was set up with.
DEFE2END_ENCRYPTION_KEY=

# Database credentials (the database is only reachable inside the compose network).
POSTGRES_USER=defe2end
POSTGRES_PASSWORD=change-me
POSTGRES_DB=defe2end

# Worker settings. The values below are the defaults; leave a line out to keep it.
# Worker name in run records (empty = container hostname + pid).
WORKER_ID=
# How often each worker records a heartbeat, in milliseconds (min 1000).
HEARTBEAT_INTERVAL_MS=10000
# A run whose worker misses heartbeats this long is taken back (ms, at least twice the heartbeat).
RUN_LEASE_MS=30000
# How often the worker looks for queued runs and for cancel requests (ms, min 50).
POLL_INTERVAL_MS=1000
CANCEL_POLL_INTERVAL_MS=1000
# Longest wait for the queue lock per claim round (ms, min 100); past it the round claims nothing.
CLAIM_LOCK_TIMEOUT_MS=3000
# How often temp files and expired test runs are cleaned up (ms, min 1000).
MAINTENANCE_INTERVAL_MS=600000
# Runs one worker executes at once / across all workers / per workspace.
WORKER_CONCURRENCY=2
MAX_CONCURRENT_RUNS=4
WORKSPACE_CONCURRENCY=4
# A run is stopped after this long (ms, min 1000).
RUN_TIMEOUT_MS=900000
# Whole-run attempts including the first; 1 = no retry.
RUN_RETRY_ATTEMPTS=2
# The worker takes no new run while free disk space is below this (MB).
MIN_FREE_DISK_MB=1024
# On shutdown, running runs get this long to finish (ms). Keep it below the compose stop_grace_period (45s).
SHUTDOWN_GRACE_MS=30000
# true = scenarios can't reach private, loopback or link-local addresses.
BLOCK_PRIVATE_NETWORKS=false
# Chromium's sandbox; turn off only on a host that can't provide user namespaces.
CHROMIUM_SANDBOX=true

# Optional: sign in with an OpenID Connect provider (on when URL and client id are set).
# Redirect URI to register at the provider: <BETTER_AUTH_URL>/api/auth/oauth2/callback/oidc
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=

# Optional: sign in with GitHub (on when both are set).
# Callback URL to register: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
