{
  "name": "@defe2end/recorder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "default": "./dist/dom.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@defe2end/i18n": "workspace:*",
    "@defe2end/shared": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@defe2end/test-fixtures": "workspace:*",
    "@types/node": "^22.20.5",
    "playwright": "1.64.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
