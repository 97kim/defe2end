{
  "extends": ["//"],
  "tasks": {
    "generate": { "inputs": ["prisma/schema.prisma", "prisma/migrations/**", "scripts/known-migrations.mjs"], "outputs": ["src/generated/**"] },
    "build": { "dependsOn": ["^build", "generate"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": ["^build", "generate"] },
    "test": { "dependsOn": ["^build", "generate"] }
  }
}
